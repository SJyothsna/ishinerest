#   "set1Incorrect": 5,             // Always populated
#   "set1NotPracticed": 30,         // Always populated
#   "set2Total": 45,                // Always populated
#   "set2Practiced": 0,             // Always populated
#   "set2Correct": 0,               // Always populated
#   "set2Incorrect": 0,             // Always populated
#   "set2NotPracticed": 45,         // Always populated
#   "set1Complete": false           // true if all Set 1 practiced
# }