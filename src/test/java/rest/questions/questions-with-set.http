### Question Set Feature - Test Cases
### This file contains test cases for the new questionSet parameter

### Variables
@baseUrl = http://localhost:8080
@studentId = 1
@chapterId = LC5H0101
@subjectId = MATH

###############################################################################
# TEST 1: Get Unpracticed Questions by Chapter - Set 1
###############################################################################

GET {{baseUrl}}/questions/unpracticed/chapter?studentId={{studentId}}&chapterId={{chapterId}}&limit=10&questionSet=1
Accept: application/json

###############################################################################
# TEST 2: Get Unpracticed Questions by Chapter - Set 2
###############################################################################

GET {{baseUrl}}/questions/unpracticed/chapter?studentId={{studentId}}&chapterId={{chapterId}}&limit=10&questionSet=2
Accept: application/json

###############################################################################
# TEST 3: Get Unpracticed Questions by Chapter - Set 3
###############################################################################

GET {{baseUrl}}/questions/unpracticed/chapter?studentId={{studentId}}&chapterId={{chapterId}}&limit=10&questionSet=3
Accept: application/json

###############################################################################
# TEST 4: Get Unpracticed Questions by Chapter - All Sets (no parameter)
###############################################################################

GET {{baseUrl}}/questions/unpracticed/chapter?studentId={{studentId}}&chapterId={{chapterId}}&limit=10
Accept: application/json

###############################################################################
# TEST 5: Get Unpracticed Questions by Chapter - All Sets (explicit)
###############################################################################

GET {{baseUrl}}/questions/unpracticed/chapter?studentId={{studentId}}&chapterId={{chapterId}}&limit=10&questionSet=all
Accept: application/json

###############################################################################
# TEST 6: Get Unpracticed Questions by Subject - Set 1
###############################################################################

GET {{baseUrl}}/questions/unpracticed/subject?studentId={{studentId}}&subjectId={{subjectId}}&limit=10&questionSet=1
Accept: application/json

###############################################################################
# TEST 7: Get Unpracticed Questions by Subject - Set 2
###############################################################################

GET {{baseUrl}}/questions/unpracticed/subject?studentId={{studentId}}&subjectId={{subjectId}}&limit=10&questionSet=2
Accept: application/json

###############################################################################
# TEST 8: Get Unpracticed Questions by Subject - All Sets
###############################################################################

GET {{baseUrl}}/questions/unpracticed/subject?studentId={{studentId}}&subjectId={{subjectId}}&limit=10
Accept: application/json

###############################################################################
# TEST 9: Get Unpracticed Questions with Flags - Set 1
###############################################################################

GET {{baseUrl}}/questions/unpracticed/chapter/with-flags?studentId={{studentId}}&chapterId={{chapterId}}&limit=10&questionSet=1
Accept: application/json

###############################################################################
# TEST 10: Get Unpracticed Questions with Flags - Set 2
###############################################################################

GET {{baseUrl}}/questions/unpracticed/chapter/with-flags?studentId={{studentId}}&chapterId={{chapterId}}&limit=10&questionSet=2
Accept: application/json

###############################################################################
# TEST 11: Combined Filters - Set 2 + Difficulty Level
###############################################################################

GET {{baseUrl}}/questions/unpracticed/chapter?studentId={{studentId}}&chapterId={{chapterId}}&limit=10&level=Medium&questionSet=2
Accept: application/json

###############################################################################
# TEST 12: Combined Filters - Set 1 + Usage Type
###############################################################################

GET {{baseUrl}}/questions/unpracticed/chapter?studentId={{studentId}}&chapterId={{chapterId}}&limit=10&usageType=Practice&questionSet=1
Accept: application/json

###############################################################################
# TEST 13: Combined Filters - Set 3 + Section ID
###############################################################################

GET {{baseUrl}}/questions/unpracticed/chapter?studentId={{studentId}}&chapterId={{chapterId}}&limit=10&sectionId=S1&questionSet=3
Accept: application/json

###############################################################################
# TEST 14: Create Question with Set 2
###############################################################################

POST {{baseUrl}}/questions
Content-Type: application/json

[
  {
    "questionText": "Test question for Set 2",
    "optionA": "Option A",
    "optionB": "Option B",
    "optionC": "Option C",
    "optionD": "Option D",
    "correctAnswer": "B",
    "questionType": 1,
    "difficultyLevel": "Easy",
    "usageType": "Practice",
    "questionSet": "2",
    "chapter": {
      "chapterId": "{{chapterId}}"
    }
  }
]

