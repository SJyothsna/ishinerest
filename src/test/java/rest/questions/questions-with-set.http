###############################################################################

POST {{baseUrl}}/questions
Content-Type: application/json

[
  {
    "questionText": "Test question with default set",
    "optionA": "Option A",
    "optionB": "Option B",
    "optionC": "Option C",
    "optionD": "Option D",
    "correctAnswer": "A",
    "questionType": 1,
    "difficultyLevel": "Easy",
    "usageType": "Practice",
