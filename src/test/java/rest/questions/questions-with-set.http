###############################################################################
# TEST 19: Progressive Practice Scenario
# Step 1: Get Set 1 questions
###############################################################################

GET {{baseUrl}}/questions/unpracticed/chapter?studentId={{studentId}}&chapterId={{chapterId}}&limit=5&questionSet=1
Accept: application/json

### Step 2: After completing Set 1, get Set 2 questions

GET {{baseUrl}}/questions/unpracticed/chapter?studentId={{studentId}}&chapterId={{chapterId}}&limit=5&questionSet=2
Accept: application/json

### Step 3: After completing Set 2, get Set 3 questions

GET {{baseUrl}}/questions/unpracticed/chapter?studentId={{studentId}}&chapterId={{chapterId}}&limit=5&questionSet=3
Accept: application/json

###############################################################################
# TEST 20: Case Insensitivity Test
###############################################################################

GET {{baseUrl}}/questions/unpracticed/chapter?studentId={{studentId}}&chapterId={{chapterId}}&limit=10&questionSet=ALL
Accept: application/json

###############################################################################
# TEST 21: Empty String Test (should return all sets)
###############################################################################

GET {{baseUrl}}/questions/unpracticed/chapter?studentId={{studentId}}&chapterId={{chapterId}}&limit=10&questionSet=
Accept: application/json

###############################################################################
# TEST 22: Get Question by ID (verify questionSet field is returned)
# Replace {questionId} with actual question ID
###############################################################################

GET {{baseUrl}}/questions/{questionId}
Accept: application/json

###############################################################################
# TEST 23: Get All Questions by Chapter (verify questionSet field)
###############################################################################

GET {{baseUrl}}/questions/chapter/{{chapterId}}
Accept: application/json

###############################################################################
# TEST 24: Subject Questions with Flags - Set 2
###############################################################################

GET {{baseUrl}}/questions/unpracticed/subject/with-flags?studentId={{studentId}}&subjectId={{subjectId}}&limit=10&questionSet=2
Accept: application/json

###############################################################################
# NOTES FOR TESTING
###############################################################################

# 1. Before running tests, ensure:
#    - Database migration has been executed
#    - Application is running on localhost:8080
#    - Test data exists in the database
#    - Student ID 1 exists
#    - Chapter LC5H0101 exists
#    - Subject MATH exists

# 2. Expected Results:
#    - Tests 1-3: Should return only questions from specified set
#    - Tests 4-5: Should return questions from all sets
#    - Tests 6-8: Should return subject questions filtered by set
#    - Tests 9-10: Should include isFlagged field in response
#    - Tests 11-13: Should apply multiple filters correctly
#    - Tests 14-16: Should create questions with specified set
#    - Tests 17-18: Should update questionSet field
#    - Test 19: Demonstrates progressive practice flow
#    - Tests 20-21: Should handle edge cases correctly
#    - Tests 22-24: Should include questionSet in responses

# 3. Verification Steps:
#    - Check response contains questionSet field
#    - Verify only questions from specified set are returned
#    - Confirm default set is "1" when not specified
#    - Validate filtering works with other parameters

# 4. Database Verification:
#    SELECT question_id, question_text, question_set 
#    FROM questions 
#    WHERE chapter_id = 'LC5H0101' 
#    ORDER BY question_set, question_id;