    }
  }
]

###############################################################################
# TEST 17: Update Question to Set 2
# Replace {questionId} with actual question ID
###############################################################################

PUT {{baseUrl}}/questions/{questionId}
Content-Type: application/json

{
  "questionText": "Updated question text",
  "optionA": "Updated A",
  "optionB": "Updated B",
  "optionC": "Updated C",
  "optionD": "Updated D",
  "correctAnswer": "B",
  "questionType": 1,
  "difficultyLevel": "Medium",
  "usageType": "Practice",
  "questionSet": "2"
}

###############################################################################
