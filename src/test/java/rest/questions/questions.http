### QuestionController
@baseUrl = http://localhost:8080
@studentId = 1
@subjectId = LC5H01
@chapterId = LC5H0102
@questionId = 1

### Get all questions
GET {{baseUrl}}/questions
Accept: application/json

###

### Get question by id
GET {{baseUrl}}/questions/{{questionId}}
Accept: application/json

###

### Get questions by chapter
GET {{baseUrl}}/questions/chapter/{{chapterId}}
Accept: application/json

###

### Get questions by subject
GET {{baseUrl}}/questions/subject/{{subjectId}}
Accept: application/json

###

### Get unpracticed questions by subject
GET {{baseUrl}}/questions/unpracticed/subject?studentId={{studentId}}&subjectId={{subjectId}}&limit=10
Accept: application/json

###

### Get unpracticed questions by chapter
GET {{baseUrl}}/questions/unpracticed/chapter?studentId={{studentId}}&chapterId={{chapterId}}&limit=10&level=Easy
Accept: application/json

###

### ========================================
### NEW ENDPOINTS WITH FLAG STATUS
### ========================================

### Get unpracticed questions by chapter WITH FLAGS
GET {{baseUrl}}/questions/unpracticed/chapter/with-flags?studentId={{studentId}}&chapterId={{chapterId}}&limit=10&level=Basic
Accept: application/json

###

### Get unpracticed questions by subject WITH FLAGS
GET {{baseUrl}}/questions/unpracticed/subject/with-flags?studentId={{studentId}}&subjectId={{subjectId}}&limit=10
Accept: application/json

###

### Get questions by chapter WITH FLAGS
GET {{baseUrl}}/questions/chapter/{{chapterId}}/with-flags?studentId={{studentId}}
Accept: application/json

###

### Get questions by subject WITH FLAGS
GET {{baseUrl}}/questions/subject/{{subjectId}}/with-flags?studentId={{studentId}}
Accept: application/json

###

### ========================================
### WRONG-UNPRACTICED QUESTIONS (Review Mistakes)
### ========================================

### Get wrong-unpracticed questions by chapter
# Returns questions that were answered incorrectly and haven't been correctly answered yet
GET {{baseUrl}}/questions/wrong-unpracticed/chapter?studentId={{studentId}}&chapterId={{chapterId}}
Accept: application/json

###

### Get wrong-unpracticed questions by subject
# Returns questions that were answered incorrectly and haven't been correctly answered yet
GET {{baseUrl}}/questions/wrong-unpracticed/subject?studentId={{studentId}}&subjectId={{subjectId}}
Accept: application/json

###

### Create questions
POST {{baseUrl}}/questions
Content-Type: application/json
Accept: application/json

[
  {
    "questionText": "What is 2 + 2?",
    "optionA": "3",
    "optionB": "4",
    "optionC": "5",
    "optionD": "6",
    "correctAnswer": "B",
    "correctAnswers": null,
    "questionType": 1,
    "difficultyLevel": "Easy",
    "explanation": "2 + 2 = 4",
    "notes": "Sample question",
    "hint": "Think about adding two pairs together before choosing the correct option.",
    "chapter": {
      "chapterId": "{{chapterId}}"
    }
  },
  {
    "questionText": "Which of these are prime numbers?",
    "optionA": "2",
    "optionB": "4",
    "optionC": "5",
    "optionD": "8",
    "correctAnswer": "",
    "correctAnswers": "A,C",
    "questionType": 4,
    "difficultyLevel": "Intermediate",
    "explanation": "2 and 5 are prime numbers.",
    "notes": "Multiple choice sample",
    "hint": "Prime numbers have exactly two factors: 1 and themselves.",
    "chapter": {
      "chapterId": "{{chapterId}}"
    }
  }
]

### Create question with image only (no text) - VALID
POST {{baseUrl}}/questions
Content-Type: application/json
Accept: application/json

[
  {
    "questionText": null,
    "optionA": "Option A",
    "optionB": "Option B",
    "optionC": "Option C",
    "optionD": "Option D",
    "correctAnswer": "A",
    "correctAnswers": null,
    "questionType": 1,
    "difficultyLevel": "Easy",
    "explanation": "This question uses only an image",
    "notes": "Image-only question",
    "questionImageUrl": "http://localhost:8080/uploads/chapters/LC5H0102/questions/q_123.png",
    "chapter": {
      "chapterId": "{{chapterId}}"
    }
  }
]

###

### Create question with both text and image - VALID
POST {{baseUrl}}/questions
Content-Type: application/json
Accept: application/json

[
  {
    "questionText": "What is shown in the image?",
    "optionA": "Option A",
    "optionB": "Option B",
    "optionC": "Option C",
    "optionD": "Option D",
    "correctAnswer": "B",
    "correctAnswers": null,
    "questionType": 1,
    "difficultyLevel": "Intermediate",
    "explanation": "This question has both text and image",
    "notes": "Combined text and image question",
    "questionImageUrl": "http://localhost:8080/uploads/chapters/LC5H0102/questions/q_124.png",
    "chapter": {
      "chapterId": "{{chapterId}}"
    }
  }
]

###

### Create question with neither text nor image - INVALID (should fail)
POST {{baseUrl}}/questions
Content-Type: application/json
Accept: application/json

[
  {
    "questionText": null,
    "optionA": "Option A",
    "optionB": "Option B",
    "optionC": "Option C",
    "optionD": "Option D",
    "correctAnswer": "A",
    "correctAnswers": null,
    "questionType": 1,
    "difficultyLevel": "Easy",
    "explanation": "This should fail validation",
    "notes": "Invalid question - no text or image",
    "questionImageUrl": null,
    "chapter": {
      "chapterId": "{{chapterId}}"
    }
  }
]


###

### Update question
PUT {{baseUrl}}/questions/{{questionId}}
Content-Type: application/json
Accept: application/json

{
  "questionText": "Updated: Which of these are even numbers?",
  "optionA": "2",
  "optionB": "3",
  "optionC": "4",
  "optionD": "5",
  "correctAnswer": "",
  "correctAnswers": "A,C",
  "questionType": 4,
  "difficultyLevel": "Easy",
  "explanation": "2 and 4 are even numbers.",
  "notes": "Updated multiple choice sample",
  "hint": "An even number is divisible by 2 without remainder.",
  "chapter": {
    "chapterId": "{{chapterId}}"
  }
}

###

### Delete question
DELETE {{baseUrl}}/questions/{{questionId}}
Accept: application/json